{
    "ConnectionStrings": {
        "DefaultConnection": "Server=localhost;Database=ClassAssignmentDb;Trusted_Connection=True;TrustServerCertificate=True;"
    },
    "Jwt": {
        "Secret": "",
        "Issuer": "ClassAssignmentSystem",
        "Audience": "ClassAssignmentSystem",
        "ExpiryMinutes": 120
    },
    "BlobStorage": {
        "ConnectionString": "",
        "AccountName": "",
        "SubmissionsContainer": "assignment-submissions",
        "AssignmentMaterialsContainer": "assignment-materials",
        "MaxFileSizeBytes": 10485760,
        "AllowedExtensions": [ ".pdf", ".doc", ".docx", ".ppt", ".pptx", ".xls", ".xlsx", ".zip", ".png", ".jpg", ".jpeg" ],
        "SasTokenExpiryMinutes": 15
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*"
}

// Local dev: put the real connection string in User Secrets, never in appsettings.json:
//   dotnet user-secrets set "BlobStorage:ConnectionString" "UseDevelopmentStorage=true"   (Azurite)
//   -- or your real Azure Storage account connection string
//
// Production (recommended): leave ConnectionString empty, set only AccountName,
// and grant the App Service / Container App's Managed Identity the
// "Storage Blob Data Contributor" role on the storage account. The
// AzureBlobStorageService automatically falls back to DefaultAzureCredential.

